# ============================================================================
# Campus Announcement Scheduler — Protected Configuration Example (.env.example)
# Week 14 Secure Integration (SA8 & IA5): Never commit real secrets to Git!
# Copy this file to `.env` and supply production secrets via environment vars.
# ============================================================================

# Server Binding & Transport Security
HOST=127.0.0.1
PORT=8080
ENABLE_TLS=false
TLS_CERT_PATH=certs/server_cert.pem
TLS_KEY_PATH=certs/server_key.pem

# Cryptographic Token Signing (HMAC-SHA256)
# MUST be at least 32 random bytes in staging/production
JWT_HMAC_SECRET=REPLACE_WITH_256_BIT_SECRET_KEY_BEFORE_DEPLOYMENT
TOKEN_TTL_MINUTES=60

# Persistence & Snapshot Recovery
STORAGE_PATH=data/announcements_db.json
SNAPSHOT_PATH=data/announcements_snapshot.json

# Week 13 Automation & Retry Policy (SA7)
SCHEDULER_INTERVAL_SECONDS=30
MAX_RETRY_ATTEMPTS=3
BASE_RETRY_BACKOFF_SECONDS=5

